# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Tempo OTLP/HTTP trace backend for obs-eio"
description: """
Converts obs-eio span events into OTLP ResourceSpans and pushes them to Tempo's
OTLP/HTTP trace-ingestion endpoint when each span closes. Not a general-purpose
OTLP client: it is the Tempo backend for obs-eio's Obs_eio.backend interface."""
maintainer: ["lbendtlynielsen@gmail.com"]
authors: ["lbendtly"]
license: "MIT"
homepage: "https://github.com/loganbnielsen/obs-tempo-eio"
bug-reports: "https://github.com/loganbnielsen/obs-tempo-eio/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.4.0"}
  "obs-eio" {>= "0.1.1"}
  "eio" {>= "1.3"}
  "eio_main" {>= "1.3" & with-test}
  "opentelemetry" {>= "0.91.0"}
  "pbrt" {>= "4.0"}
  "uri" {>= "4.4.0"}
  "https-eio" {>= "0.1.1"}
  "cohttp-eio" {>= "6.2.0" & with-test}
  "http" {>= "6.0.0" & with-test}
  "yojson" {>= "3.0.0" & with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/loganbnielsen/obs-tempo-eio.git"
